{
  "name": "unofficial-fun-department",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "server:dev": "tsx watch server/index.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:backend": "tsx --test server/test/backend.test.ts",
    "test:watch": "vitest",
    "db:view": "node scripts/view_database.mjs",
    "download:songs": "tsx scripts/downloadSongs.ts",
    "resolve-songs": "node --loader ts-node/esm scripts/resolveSongs.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/manrope": "^5.1.0",
    "@fontsource/noto-sans-devanagari": "^5.1.0",
    "@phosphor-icons/react": "^2.1.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "fflate": "^0.8.2",
    "fix-webm-duration": "^1.0.6",
    "idb": "^8.0.0",
    "multer": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/react": "^16.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "vite": "^6.0.1",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.5"
  }
